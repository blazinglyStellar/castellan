# HTTP server port
PORT=8080

# Maximum request body size accepted by the gateway, in bytes (default: 10MB)
MAX_BODY_SIZE=10485760

# Runtime environment (local / dev / staging / production)
APP_ENV=local

DB_HOST=localhost
DB_PORT=5432
DB_DATABASE=castellan
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_SCHEMA=public

# Postgres connection string used at runtime (by cmd/api/main.go)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/castellan?sslmode=disable"

# Upstream proxy timeouts (Go duration format)
UPSTREAM_CONNECT_TIMEOUT=5s
UPSTREAM_READ_TIMEOUT=30s
UPSTREAM_WRITE_TIMEOUT=30s

# Upstream retry configuration (jittered exponential backoff)
RETRY_MAX_RETRIES=3
RETRY_BASE_DELAY=200ms
RETRY_MAX_DELAY=3s

# API key + session token configuration.
# NOTE: These are documented defaults. The auth package currently uses
# hard-coded compile-time constants (see internal/auth/keys.go and
# sessions.go). Wiring these env vars into the auth service is tracked as
# a follow-up — see GH issue #55.
API_KEY_PREFIX=ca_
API_KEY_BYTES=32
SESSION_TOKEN_PREFIX=st_
SESSION_TOKEN_DEFAULT_TTL=1h

# Goose migration settings (used by goose CLI, not by the app)
GOOSE_DRIVER=postgres
GOOSE_DBSTRING="postgresql://postgres:postgres@localhost:5432/castellan"
GOOSE_MIGRATION_DIR=./migrations
