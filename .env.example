# HTTP server port
PORT=8080

# Maximum request body size accepted by the gateway, in bytes (default: 10MB)
MAX_BODY_SIZE=10485760

# Runtime environment (local / dev / staging / production)
APP_ENV=local

DB_HOST=localhost
DB_PORT=5432
DB_DATABASE=castellan
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_SCHEMA=public

# Postgres connection string for goose migrations (Makefile / goose CLI — not read by app code)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/castellan?sslmode=disable"

# Upstream proxy timeouts (Go duration format)
UPSTREAM_CONNECT_TIMEOUT=5s
UPSTREAM_READ_TIMEOUT=30s
UPSTREAM_WRITE_TIMEOUT=30s

# Upstream retry configuration (jittered exponential backoff)
RETRY_MAX_RETRIES=3
RETRY_BASE_DELAY=200ms
RETRY_MAX_DELAY=3s

# Seed mode: set SEED=true to run database seed on server start (dev-only)
# Alternatively, use: make seed
SEED=false

# OAuth 2.0 configuration (Google + GitHub)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Dashboard URL used for CORS origin + post-auth redirect
# Required — no default (like PORT)
DASHBOARD_URL=http://localhost:3000

# API base URL used for OAuth provider callback URIs (registered with Google/GitHub)
API_BASE_URL=http://localhost:8080

# Secret key for gorilla/sessions cookie store (OAuth state)
# Generate with: openssl rand -base64 64
SESSION_STORE_SECRET=change-me-to-a-random-64-char-string

# Redis configuration
REDIS_URL=redis://localhost:6379/0
# Redis port for docker-compose host port mapping (not read by app code)
REDIS_PORT=6379

# Rate limiting
RATE_LIMIT_WINDOW_SECONDS=60

# Stellar configuration
STELLAR_HORIZON=https://horizon-testnet.stellar.org
STELLAR_NETWORK=testnet   # testnet or pubnet
STELLAR_HOT_WALLET_ADDRESS=
WALLET_SECRET_KEY=
STELLAR_DEPOSIT_MIN_AMOUNT=5

# Settlement cycle configuration
SETTLEMENT_INTERVAL=5m
SETTLEMENT_MIN_THRESHOLD=5

# Frontend configuration (consumed by the Next.js dashboard via NEXT_PUBLIC_ prefix)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# Stellar network for frontend explorer links (testnet or pubnet)
# Overridden at build time by STELLAR_NETWORK env var via next.config.ts
NEXT_PUBLIC_STELLAR_NETWORK=testnet

# GitHub repository URL for the top-nav GitHub icon link
NEXT_PUBLIC_GITHUB_URL=https://github.com/blazinglyStellar/castellan

# Goose migration settings (used by goose CLI, not by the app)
GOOSE_DRIVER=postgres
GOOSE_DBSTRING="postgresql://postgres:postgres@localhost:5432/castellan"
GOOSE_MIGRATION_DIR=./migrations
